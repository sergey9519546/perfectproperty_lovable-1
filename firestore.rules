rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['id', 'email', 'createdAt', 'updatedAt'])
        && data.id == userId
        && data.id == request.auth.uid
        && data.email is string && data.email.size() > 0 && data.email.size() <= 254
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('tier' in data) || (data.tier in ['free', 'pro', 'enterprise']))
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidSavedDeal(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'parcelId', 'address', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.parcelId is string && data.parcelId.size() > 0 && data.parcelId.size() <= 128
        && data.address is string && data.address.size() > 0 && data.address.size() <= 300
        && (!('county' in data) || (data.county is string && data.county.size() <= 100))
        && (!('state' in data) || (data.state is string && data.state.size() <= 10))
        && (!('arv' in data) || (data.arv is number))
        && (!('maxBid' in data) || (data.maxBid is number))
        && (!('predictedSpread' in data) || (data.predictedSpread is number))
        && (!('underwriteStatus' in data) || (data.underwriteStatus is string && data.underwriteStatus.size() <= 50))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 10000))
        && (!('starred' in data) || (data.starred is bool))
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidUserFilterPreset(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'createdAt'])
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!('county' in data) || (data.county is string && data.county.size() <= 100))
        && (!('minScore' in data) || (data.minScore is number))
        && (!('maxPrice' in data) || (data.maxPrice is number))
        && (!('isShadowOnly' in data) || (data.isShadowOnly is bool))
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // User profile
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isAuthenticated();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      // User saved deals subcollection
      match /savedDeals/{dealId} {
        allow get: if isOwner(userId) && isValidId(dealId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(dealId) && isValidSavedDeal(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(dealId) && isValidSavedDeal(request.resource.data, userId);
        allow delete: if isOwner(userId) && isValidId(dealId);
      }

      // User filter presets subcollection
      match /filterPresets/{presetId} {
        allow get: if isOwner(userId) && isValidId(presetId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(presetId) && isValidUserFilterPreset(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(presetId) && isValidUserFilterPreset(request.resource.data, userId);
        allow delete: if isOwner(userId) && isValidId(presetId);
      }
    }
  }
}
